#: web/state.py
#, python-format
msgid "The model is not configured: define %(names)s in the .env file (for ingestion the WIKI_LLM_* variables also work)."
msgstr ""
"Falta configurar el modelo: define %(names)s en el archivo .env (para la ingesta sirven también las variables "
"WIKI_LLM_*)."

#: web/routes/audit.py
msgid "That answer does not exist."
msgstr "Esa respuesta no existe."

#: web/routes/audit.py
msgid "That conversation has no answer."
msgstr "Esa conversación no tiene ninguna respuesta."

#: web/routes/chat.py
msgid "There is no answered question to save."
msgstr "No hay ninguna pregunta con respuesta para guardar."

#: web/routes/chat.py web/templates/page.html
#, python-format

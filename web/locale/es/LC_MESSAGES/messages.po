msgstr "Verificando las oraciones…"

#: web/routes/chat.py
msgid "Could not verify. The answer was not compared with the fragments of the original documents."
msgstr "No se pudo verificar. La respuesta no se comparó con los fragmentos de los documentos originales."

#: web/routes/chat.py
msgid "Could not verify"
msgstr "No se pudo verificar"

#: web/routes/chat.py
msgid "Enter a title for the page."
msgstr "Escribí un título para la página."

#: web/routes/chat.py
#, python-format
msgid "Could not prepare the draft: %(error)s"
msgstr "No se pudo preparar el borrador: %(error)s"

#: web/routes/chat.py web/routes/pages.py
msgid "The local verifier is not installed."
msgstr "El verificador local no está instalado."

#: web/routes/chat.py
msgid "The conversation kept no passage to verify the draft against."
msgstr "La conversación no conservó ningún pasaje contra el cual verificar el borrador."

#: web/routes/chat.py
msgid "The page cannot be empty."
msgstr "La página no puede estar vacía."

#: web/routes/chat.py
#, python-format
msgid "Could not save: %(error)s"
msgstr "No se pudo guardar: %(error)s"

#: web/routes/chat.py
#, python-format
msgid "Updated the page “%(title)s”."
msgstr "Se actualizó la página «%(title)s»."

#: web/routes/chat.py
#, python-format
msgid "Created the page “%(title)s”."
msgstr "Se creó la página «%(title)s»."

#: web/routes/chat.py web/templates/_vocabulary_body.html
msgid "Open the page"
msgstr "Abrir la página"

#: web/routes/datasets.py
msgid "The data file does not exist."
msgstr "El archivo de datos no existe."

#: web/routes/history.py
msgid "⏪ Restoring the pages of "
msgstr "⏪ Restaurando las páginas de "

#: web/routes/history.py
msgid "🗄 Restoring the index snapshot"
msgstr "🗄 Restaurando la copia del índice"

#: web/routes/history.py
msgid "🗄 No snapshot to use: rebuilding the index from the files"
msgstr "🗄 Este punto no tiene copia del índice: se reconstruye desde los archivos"

#: web/routes/history.py
msgid "This point has no index copy, and rebuilding it needs Java, which is not installed."
msgstr "Este punto no tiene copia del índice, y reconstruirlo necesita Java, que no está instalado."

#: web/routes/history.py
msgid ""
"This point has no index copy, and rebuilding it needs LibreOffice for the office documents of sources/, which is not "
"installed."
msgstr ""
"Este punto no tiene copia del índice, y reconstruirlo necesita LibreOffice para los documentos de office de sources/,"
" que no está instalado."

#: web/routes/history.py
msgid "This point has no index copy, and the text of no source could be extracted to rebuild it."
msgstr "Este punto no tiene copia del índice, y no se pudo extraer el texto de ninguna fuente para reconstruirlo."

#: web/routes/history.py
msgid "The index of this point could not be restored."
msgstr "No se pudo restaurar el índice de este punto."

#: web/routes/history.py
msgid "That point of the history does not exist."
msgstr "Ese punto del historial no existe."

#: web/routes/history.py
#, python-format
msgid "There is %(n)s unsaved change in wiki/ and going back would lose it."
msgid_plural "There are %(n)s unsaved changes in wiki/ and going back would lose them."
msgstr[0] "Hay %(n)s cambio sin guardar en wiki/ y volver lo perdería."
msgstr[1] "Hay %(n)s cambios sin guardar en wiki/ y volver los perdería."

#: web/routes/history.py
msgid "The wiki has no history: WIKI_AUTOCOMMIT is 0 or git is not available."
msgstr "La wiki no tiene historial: WIKI_AUTOCOMMIT está en 0 o git no está disponible."

#: web/routes/history.py
#, python-format
msgid "Did not go back: there are unsaved changes in wiki/ and they would be lost. Files: %(files)s"
msgstr "No se volvió atrás: hay cambios sin guardar en wiki/ y se perderían. Archivos: %(files)s"

#: web/routes/history.py
msgid "Nothing was changed: the pages and the index stay as they were."
msgstr "No se cambió nada: las páginas y el índice quedan como estaban."

#: web/routes/history.py
#, python-format
msgid "Did not go back: %(error)s"
msgstr "No se volvió atrás: %(error)s"

#: web/routes/history.py
msgid "restored from its copy"
msgstr "restaurado de su copia"

#: web/routes/history.py
msgid "rebuilt from the files"
msgstr "reconstruido desde los archivos"

#: web/routes/history.py
#, python-format
msgid "Recorded as point %(sha)s."
msgstr "Quedó registrado como el punto %(sha)s."

#: web/routes/history.py
msgid "The pages were already identical, so no point was added."
msgstr "Las páginas ya eran idénticas, así que no se agregó ningún punto."

#: web/routes/history.py
#, python-format
msgid "🏁 The wiki went back to point %(sha)s: %(pages)s pages; index %(index)s."
msgstr "🏁 La wiki volvió al punto %(sha)s: %(pages)s páginas; índice %(index)s."

#: web/routes/history.py web/routes/pages.py web/routes/relations.py web/templates/page.html
msgid "The page does not exist."
msgstr "La página no existe."


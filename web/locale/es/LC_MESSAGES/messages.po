msgstr "%(formats)s o %(last)s"

#: web/routes/ingest.py
#, python-format
msgid "🏁 %(label)s: %(ingested)s ingested, %(skipped)s skipped, %(failed)s failed"
msgstr "🏁 %(label)s: %(ingested)s ingestados, %(skipped)s omitidos, %(failed)s fallidos"

#: web/routes/ingest.py
#, python-format
msgid "⚠️ %(name)s: format not supported; supported formats are %(formats)s"
msgstr "⚠️ %(name)s: formato no admitido; se admiten %(formats)s"

#: web/routes/ingest.py
#, python-format
msgid "⚠️ %(name)s: invalid file name"
msgstr "⚠️ %(name)s: nombre de archivo no válido"

#: web/routes/ingest.py
msgid "file"
msgstr "archivo"

#: web/routes/ingest.py web/templates/ingest.html
msgid "Ingestion"
msgstr "Ingesta"

#: web/routes/ingest.py
msgid "Scan"
msgstr "Escaneo"

#: web/routes/ingest.py
msgid "Regeneration"
msgstr "Regeneración"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Review and repair: %(issues)s problem(s) found"
msgstr "🏁 Revisión y reparación: %(issues)s problema(s) encontrado(s)"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Index rebuilt: %(sources)s sources, %(pages)s pages, %(references)s references"
msgstr "🏁 Índice reconstruido: %(sources)s fuentes, %(pages)s páginas, %(references)s referencias"

#: web/routes/ingest.py
#, python-format
msgid "; %(failed)s sources with errors"
msgstr "; %(failed)s fuentes con error"

#: web/routes/ingest.py
#, python-format
msgid "The text of no source could be extracted, so the current index stays as it was. First error: %(error)s"
msgstr "No se pudo extraer el texto de ninguna fuente, así que el índice actual queda como estaba. Primer error: %(error)s"

#: web/routes/ingest.py
msgid "→ Installing torch, the build without CUDA"
msgstr "→ Instalando torch, la versión sin CUDA"

#: web/routes/ingest.py
msgid "→ Installing the packages of the verifier"
msgstr "→ Instalando los paquetes del verificador"

#: web/routes/ingest.py
msgid "→ Downloading the NLI model"
msgstr "→ Bajando el modelo NLI"

#: web/routes/ingest.py
#, python-format
msgid ""
"The step “%(step)s” ended with the code %(code)s. The verifier is not installed. The lines above give the cause. The "
"button runs every step again."
msgstr ""
"El paso «%(step)s» terminó con el código %(code)s. El verificador no quedó instalado. Las líneas de arriba dan la "
"causa. El botón vuelve a ejecutar todos los pasos."

#: web/routes/ingest.py
msgid "The steps ended, but the verifier is still not found."
msgstr "Los pasos terminaron, pero el verificador todavía no aparece."

#: web/routes/ingest.py
msgid "✓ The verifier is installed. Reload a screen to use it."
msgstr "✓ El verificador está instalado. Recargá una pantalla para usarlo."

#: web/routes/ingest.py
msgid "An installation of the verifier is already running."
msgstr "Ya hay una instalación del verificador en curso."

#: web/routes/ingest.py
msgid ""
"The vision model is not configured: set it in the Settings screen, or define VISION_BASE_URL, VISION_API_KEY and "
"VISION_MODEL in the .env file."
msgstr ""
"El modelo de visión no está configurado: definilo en la pantalla Configuración, o definí VISION_BASE_URL, "
"VISION_API_KEY y VISION_MODEL en el archivo .env."

#: web/routes/ingest.py
#, python-format
msgid "🏁 Images: %(described)s described, %(pending)s without description"
msgstr "🏁 Imágenes: %(described)s descritas, %(pending)s sin descripción"

#: web/routes/ingest.py
#, python-format
msgid "Deleted %(n)s stale page."
msgid_plural "Deleted %(n)s stale pages."
msgstr[0] "Se borró %(n)s página obsoleta."
msgstr[1] "Se borraron %(n)s páginas obsoletas."

#: web/routes/ingest.py
#, python-format
msgid "🗑 Deleting the source “%(filename)s”"
msgstr "🗑 Borrando la fuente «%(filename)s»"

#: web/routes/ingest.py
#, python-format
msgid "Could not delete the source “%(filename)s”: %(error)s"
msgstr "No se pudo borrar la fuente «%(filename)s»: %(error)s"

#: web/routes/ingest.py
#, python-format
msgid "Deleted the summary page %(page)s"
msgstr "Borrada la página de resumen %(page)s"

#: web/routes/ingest.py
#, python-format
msgid "%(count)s page marked as stale: %(pages)s"
msgid_plural "%(count)s pages marked as stale: %(pages)s"
msgstr[0] "%(count)s página marcada como obsoleta: %(pages)s"
msgstr[1] "%(count)s páginas marcadas como obsoletas: %(pages)s"

#: web/routes/ingest.py
msgid "Removed the file from sources/"
msgstr "Archivo quitado de sources/"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Deleted the source “%(filename)s”."
msgstr "🏁 Se borró la fuente «%(filename)s»."

#: web/routes/ingest.py
msgid "That operation has already finished."
msgstr "Esa operación ya terminó."

#: web/routes/pages.py web/templates/page.html
msgid "Home"
msgstr "Inicio"

#: web/routes/pages.py
#, python-format
msgid "Could not verify: %(error)s"
msgstr "No se pudo verificar: %(error)s"

#: web/routes/pages.py
#, python-format
msgid "%(filename)s cannot be shown: %(error)s"
msgstr "No se puede mostrar %(filename)s: %(error)s"

#: web/routes/pages.py
msgid "Source document"
msgstr "Documento fuente"

#: web/routes/pages.py
msgid "The document is empty."
msgstr "El documento está vacío."

#: web/routes/pages.py
#, python-format
msgid "The page “%(page)s” is fixed and cannot be deleted."
msgstr "La página «%(page)s» es fija y no se puede borrar."

#: web/routes/picker.py
msgid "Write an absolute path."
msgstr "Escribí una ruta absoluta."

#: web/routes/picker.py
msgid "No folder at that path."
msgstr "No hay una carpeta en esa ruta."

#: web/routes/picker.py
msgid "The folder cannot be read."
msgstr "No se puede leer la carpeta."

#: web/routes/picker.py
msgid "Write a name for the folder."
msgstr "Escribí un nombre para la carpeta."

#: web/routes/picker.py
msgid "A folder name cannot contain “/” nor start with a dot."
msgstr "El nombre de una carpeta no puede contener «/» ni empezar con un punto."

#: web/routes/picker.py
msgid "A folder with that name already exists."
msgstr "Ya existe una carpeta con ese nombre."

#: web/routes/picker.py
#, python-format
msgid "The folder could not be created: %(reason)s"
msgstr "No se pudo crear la carpeta: %(reason)s"

#: web/routes/settings.py
msgid "Saved. The changes apply from the next question; the earlier answers do not change."
msgstr "Guardado. Los cambios se aplican desde la próxima pregunta; las respuestas anteriores no cambian."

#: web/routes/settings.py
msgid "Saved in .env. The models apply from the next question and the next ingestion."
msgstr "Guardado en .env. Los modelos se aplican desde la próxima pregunta y la próxima ingesta."

#: web/routes/settings.py
msgid "Write a text."
msgstr "Escribí un texto."

#: web/routes/settings.py
msgid "Write a number."
msgstr "Escribí un número."

#: web/routes/settings.py
msgid "The value must be between 0 and 1."
msgstr "El valor debe estar entre 0 y 1."

#: web/routes/settings.py
msgid "Write a whole number, 1 or more."
msgstr "Escribí un número entero, 1 o más."

#: web/routes/settings.py
msgid "Write a whole number, 0 or more."
msgstr "Escribí un número entero, 0 o más."

#: web/routes/settings.py
msgid "The value is not valid."
msgstr "El valor no es válido."

#: web/routes/settings.py
msgid "The models cannot be edited here: there is no .env file to write."
msgstr "Los modelos no se pueden editar acá: no hay un archivo .env donde escribirlos."

#: web/routes/settings.py
msgid "These values were not tested. Save them anyway?"
msgstr "Estos valores no se probaron. ¿Guardarlos igual?"

#: web/routes/settings.py
msgid "The last test of these values failed. Save them anyway?"
msgstr "La última prueba de estos valores falló. ¿Guardarlos igual?"

#: web/routes/settings.py
msgid "It answers from the page and cites it"
msgstr "Responde con la página y la cita"

#: web/routes/settings.py
msgid "It declines when the page has no answer"
msgstr "Se niega cuando la página no tiene la respuesta"

#: web/routes/settings.py
msgid "It searches the wiki with the tools"
msgstr "Busca en la wiki con las herramientas"

#: web/routes/settings.py
msgid "It writes the summary page and the concept pages"
msgstr "Escribe la página de resumen y las páginas de concepto"

#: web/routes/settings.py
msgid "It reads the scanned page"
msgstr "Lee la página escaneada"

#: web/routes/settings.py
msgid "It describes an image in the format asked"
msgstr "Describe una imagen con el formato pedido"

#: web/routes/settings.py
msgid "That group of models does not exist."
msgstr "Ese grupo de modelos no existe."

#: web/routes/settings.py
#, python-format
msgid "✓ %(check)s"
msgstr "✓ %(check)s"

#: web/routes/settings.py
#, python-format
msgid "? %(check)s: no answer from the service (%(detail)s)"
msgstr "? %(check)s: el servicio no respondió (%(detail)s)"

#: web/routes/settings.py
#, python-format
msgid "✗ %(check)s: %(detail)s"
msgstr "✗ %(check)s: %(detail)s"

#: web/routes/settings.py
#, python-format
msgid "✓ The model passed the %(n)s checks (%(seconds)s s). Passing is necessary, not sufficient."
msgstr "✓ El modelo pasó las %(n)s comprobaciones (%(seconds)s s). Pasar es necesario, no suficiente."

#: web/routes/settings.py
#, python-format
msgid "✗ The model failed %(failed)s of %(n)s checks (%(seconds)s s)."
msgstr "✗ El modelo falló %(failed)s de %(n)s comprobaciones (%(seconds)s s)."

#: web/routes/settings.py
msgid "? The tests could not run: the service gave no answer."
msgstr "? Las pruebas no pudieron correr: el servicio no respondió."

#: web/routes/settings.py
msgid "Write the URL, the key and the model before testing."
msgstr "Escribí la URL, la clave y el modelo antes de probar."

#: web/routes/settings.py
msgid "A test is already running."
msgstr "Ya hay una prueba en curso."

#: web/routes/settings.py
msgid "Write a URL that starts with http:// or https://."
msgstr "Escribí una URL que empiece con http:// o https://."

#: web/routes/settings.py
#, python-format
msgid "The .env file could not be written: %(error)s"
msgstr "No se pudo escribir el archivo .env: %(error)s"

#: web/routes/tools.py
msgid "The wiki has no data files."
msgstr "La wiki no tiene archivos de datos."

#: web/routes/tools.py
msgid "The data tools of a domain replace it."
msgstr "Las herramientas de datos de un dominio la reemplazan."

#: web/routes/tools.py
msgid "No data category of the domain meets its requirements."
msgstr "Ninguna categoría de datos del dominio cumple sus requisitos."

#: web/routes/tools.py
msgid "The data category of the tool does not meet its requirements."
msgstr "La categoría de datos de la herramienta no cumple sus requisitos."

#: web/routes/tools.py
msgid "Evidence: the code cites its result as a source."
msgstr "Evidencia: el código cita su resultado como fuente."

#: web/routes/tools.py
msgid "Verbatim: the code appends its result to the answer."
msgstr "Textual: el código agrega su resultado a la respuesta."

#: web/routes/tools.py
msgid "The code does not cite its result."
msgstr "El código no cita su resultado."

#: web/routes/vocabulary.py
msgid "Write a term."
msgstr "Escribí un término."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is already in the list."
msgstr "«%(term)s» ya está en la lista."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is not in the list."
msgstr "«%(term)s» no está en la lista."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is a topic the wiki covers: it cannot go to the blacklist."

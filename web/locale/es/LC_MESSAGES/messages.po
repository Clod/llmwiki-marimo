msgid_plural "%(unsupported)s of %(checked)s sentences without support"
msgstr[0] "%(unsupported)s de %(checked)s oración sin respaldo"
msgstr[1] "%(unsupported)s de %(checked)s oraciones sin respaldo"

#: web/routes/chat.py web/templates/page.html
#, python-format
msgid "%(described)s supported by an image description"
msgid_plural "%(described)s supported by image descriptions"
msgstr[0] "%(described)s respaldada por una descripción de imagen"
msgstr[1] "%(described)s respaldadas por descripciones de imágenes"

#: web/routes/chat.py
#, python-format
msgid "%(n)s figure without support"
msgid_plural "%(n)s figures without support"
msgstr[0] "%(n)s cifra sin respaldo"
msgstr[1] "%(n)s cifras sin respaldo"

#: web/routes/chat.py
#, python-format
msgid "unknown mode: %(mode)s"
msgstr "modo desconocido: %(mode)s"

#: web/routes/chat.py
msgid "That question is no longer in progress."
msgstr "Esa pregunta ya no está en curso."

#: web/routes/chat.py
#, python-format

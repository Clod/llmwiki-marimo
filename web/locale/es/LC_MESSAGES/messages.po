#: web/app.py
#, python-format
msgid "That wiki does not exist: %(wiki)s"
msgstr "Esa wiki no existe: %(wiki)s"

#: web/app.py web/templates/base.html
msgid "Back to the list of wikis"
msgstr "Volver a la lista de wikis"

#: web/app.py
msgid "Cannot open the index of this wiki."
msgstr "No se puede abrir el índice de esta wiki."

#: web/deps.py
msgid "Another operation is running on this wiki."
msgstr "Hay otra operación en curso sobre esta wiki."

#: web/deps.py
msgid "Pre-retrieval"
msgstr "Recuperación previa"

#: web/deps.py
msgid "The code searches the wiki before calling the model and passes it the pages found"
msgstr "El código busca en la wiki antes de llamar al modelo y le pasa las páginas encontradas"

#: web/deps.py
msgid "Strict"
msgstr "Estricto"

#: web/deps.py
msgid "The model queries the wiki with tools; if it did not, the answer is replaced by a refusal"
msgstr "El modelo consulta la wiki con herramientas; si no la consultó, la respuesta se reemplaza por un rechazo"

#: web/deps.py
msgid "No verification"
msgstr "Sin verificación"

#: web/deps.py
msgid "The answer appears as the model generates it. The code does not check that the answer comes from the wiki"
msgstr "La respuesta aparece a medida que el modelo la genera. El código no comprueba que la respuesta salga de la wiki"


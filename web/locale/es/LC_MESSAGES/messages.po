msgstr ""
"Falta configurar el modelo: define %(names)s en el archivo .env (para la ingesta sirven también las variables "
"WIKI_LLM_*)."

#: web/routes/chat.py
msgid "There is no answered question to save."
msgstr "No hay ninguna pregunta con respuesta para guardar."

#: web/routes/chat.py
#, python-format
msgid "unknown mode: %(mode)s"
msgstr "modo desconocido: %(mode)s"

#: web/routes/chat.py
msgid "That question is no longer in progress."
msgstr "Esa pregunta ya no está en curso."

#: web/routes/chat.py
#, python-format
msgid "Could not answer: %(error)s"
msgstr "No se pudo responder: %(error)s"

#: web/routes/chat.py
msgid "Enter a title for the page."
msgstr "Escribí un título para la página."

#: web/routes/chat.py
#, python-format
msgid "Could not prepare the draft: %(error)s"
msgstr "No se pudo preparar el borrador: %(error)s"

#: web/routes/chat.py
msgid "The page cannot be empty."
msgstr "La página no puede estar vacía."

#: web/routes/chat.py
#, python-format
msgid "Could not save: %(error)s"
msgstr "No se pudo guardar: %(error)s"

#: web/routes/chat.py
#, python-format
msgid "Updated the page “%(title)s”."
msgstr "Se actualizó la página «%(title)s»."

#: web/routes/chat.py
#, python-format
msgid "Created the page “%(title)s”."
msgstr "Se creó la página «%(title)s»."


msgid "Open the page"
msgstr "Abrir la página"

#: web/routes/history.py
msgid "⏪ Restoring the pages of "
msgstr "⏪ Restaurando las páginas de "

#: web/routes/history.py
msgid "🗄 Restoring the index snapshot"
msgstr "🗄 Restaurando la copia del índice"

#: web/routes/history.py
msgid "🗄 No snapshot to use: rebuilding the index from the files"
msgstr "🗄 Este punto no tiene copia del índice: se reconstruye desde los archivos"

#: web/routes/history.py
msgid "This point has no index copy, and rebuilding it needs Java, which is not installed."
msgstr "Este punto no tiene copia del índice, y reconstruirlo necesita Java, que no está instalado."

#: web/routes/history.py
msgid ""
"This point has no index copy, and rebuilding it needs LibreOffice for the office documents of sources/, which is not "
"installed."
msgstr ""
"Este punto no tiene copia del índice, y reconstruirlo necesita LibreOffice para los documentos de office de sources/,"
" que no está instalado."

#: web/routes/history.py
msgid "This point has no index copy, and the text of no source could be extracted to rebuild it."
msgstr "Este punto no tiene copia del índice, y no se pudo extraer el texto de ninguna fuente para reconstruirlo."

#: web/routes/history.py
msgid "The index of this point could not be restored."
msgstr "No se pudo restaurar el índice de este punto."

#: web/routes/history.py
msgid "That point of the history does not exist."
msgstr "Ese punto del historial no existe."

#: web/routes/history.py
#, python-format
msgid "There is %(n)s unsaved change in wiki/ and going back would lose it."
msgid_plural "There are %(n)s unsaved changes in wiki/ and going back would lose them."
msgstr[0] "Hay %(n)s cambio sin guardar en wiki/ y volver lo perdería."
msgstr[1] "Hay %(n)s cambios sin guardar en wiki/ y volver los perdería."

#: web/routes/history.py
msgid "The wiki has no history: WIKI_AUTOCOMMIT is 0 or git is not available."
msgstr "La wiki no tiene historial: WIKI_AUTOCOMMIT está en 0 o git no está disponible."

#: web/routes/history.py
#, python-format
msgid "Did not go back: there are unsaved changes in wiki/ and they would be lost. Files: %(files)s"
msgstr "No se volvió atrás: hay cambios sin guardar en wiki/ y se perderían. Archivos: %(files)s"

#: web/routes/history.py
msgid "Nothing was changed: the pages and the index stay as they were."
msgstr "No se cambió nada: las páginas y el índice quedan como estaban."

#: web/routes/history.py
#, python-format
msgid "Did not go back: %(error)s"
msgstr "No se volvió atrás: %(error)s"

#: web/routes/history.py
msgid "restored from its copy"
msgstr "restaurado de su copia"

#: web/routes/history.py
msgid "rebuilt from the files"
msgstr "reconstruido desde los archivos"

#: web/routes/history.py
#, python-format
msgid "Recorded as point %(sha)s."
msgstr "Quedó registrado como el punto %(sha)s."

#: web/routes/history.py
msgid "The pages were already identical, so no point was added."
msgstr "Las páginas ya eran idénticas, así que no se agregó ningún punto."

#: web/routes/history.py
#, python-format
msgid "🏁 The wiki went back to point %(sha)s: %(pages)s pages; index %(index)s."
msgstr "🏁 La wiki volvió al punto %(sha)s: %(pages)s páginas; índice %(index)s."

#: web/routes/history.py web/routes/pages.py web/routes/relations.py web/templates/page.html
msgid "The page does not exist."
msgstr "La página no existe."

#: web/routes/ingest.py
#, python-format
msgid "%(formats)s or %(last)s"
msgstr "%(formats)s o %(last)s"

#: web/routes/ingest.py
#, python-format
msgid "🏁 %(label)s: %(ingested)s ingested, %(skipped)s skipped, %(failed)s failed"
msgstr "🏁 %(label)s: %(ingested)s ingestados, %(skipped)s omitidos, %(failed)s fallidos"

#: web/routes/ingest.py
#, python-format
msgid "⚠️ %(name)s: format not supported; supported formats are %(formats)s"
msgstr "⚠️ %(name)s: formato no admitido; se admiten %(formats)s"

#: web/routes/ingest.py
#, python-format
msgid "⚠️ %(name)s: invalid file name"
msgstr "⚠️ %(name)s: nombre de archivo no válido"

#: web/routes/ingest.py
msgid "file"
msgstr "archivo"

#: web/routes/ingest.py web/templates/ingest.html
msgid "Ingestion"
msgstr "Ingesta"

#: web/routes/ingest.py
msgid "Scan"
msgstr "Escaneo"

#: web/routes/ingest.py
msgid "Regeneration"
msgstr "Regeneración"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Review and repair: %(issues)s problem(s) found"
msgstr "🏁 Revisión y reparación: %(issues)s problema(s) encontrado(s)"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Index rebuilt: %(sources)s sources, %(pages)s pages, %(references)s references"
msgstr "🏁 Índice reconstruido: %(sources)s fuentes, %(pages)s páginas, %(references)s referencias"

#: web/routes/ingest.py
#, python-format
msgid "; %(failed)s sources with errors"
msgstr "; %(failed)s fuentes con error"

#: web/routes/ingest.py
#, python-format
msgid "The text of no source could be extracted, so the current index stays as it was. First error: %(error)s"
msgstr "No se pudo extraer el texto de ninguna fuente, así que el índice actual queda como estaba. Primer error: %(error)s"

#: web/routes/ingest.py
#, python-format
msgid "Deleted %(n)s stale page."
msgid_plural "Deleted %(n)s stale pages."
msgstr[0] "Se borró %(n)s página obsoleta."
msgstr[1] "Se borraron %(n)s páginas obsoletas."

#: web/routes/ingest.py
#, python-format
msgid "🗑 Deleting the source “%(filename)s”"
msgstr "🗑 Borrando la fuente «%(filename)s»"

#: web/routes/ingest.py
#, python-format
msgid "Could not delete the source “%(filename)s”: %(error)s"
msgstr "No se pudo borrar la fuente «%(filename)s»: %(error)s"

#: web/routes/ingest.py
#, python-format
msgid "Deleted the summary page %(page)s"
msgstr "Borrada la página de resumen %(page)s"

#: web/routes/ingest.py
#, python-format
msgid "%(count)s page marked as stale: %(pages)s"
msgid_plural "%(count)s pages marked as stale: %(pages)s"
msgstr[0] "%(count)s página marcada como obsoleta: %(pages)s"
msgstr[1] "%(count)s páginas marcadas como obsoletas: %(pages)s"

#: web/routes/ingest.py
msgid "Removed the file from sources/"
msgstr "Archivo quitado de sources/"

#: web/routes/ingest.py
#, python-format
msgid "🏁 Deleted the source “%(filename)s”."
msgstr "🏁 Se borró la fuente «%(filename)s»."

#: web/routes/ingest.py
msgid "That operation has already finished."
msgstr "Esa operación ya terminó."

#: web/routes/pages.py
#, python-format
msgid "%(filename)s cannot be shown: %(error)s"
msgstr "No se puede mostrar %(filename)s: %(error)s"

#: web/routes/pages.py
msgid "Source document"
msgstr "Documento fuente"

#: web/routes/pages.py
msgid "The document is empty."
msgstr "El documento está vacío."

#: web/routes/pages.py
#, python-format
msgid "The page “%(page)s” is fixed and cannot be deleted."
msgstr "La página «%(page)s» es fija y no se puede borrar."

#: web/routes/picker.py
msgid "Write an absolute path."
msgstr "Escribí una ruta absoluta."

#: web/routes/picker.py
msgid "No folder at that path."
msgstr "No hay una carpeta en esa ruta."

#: web/routes/picker.py
msgid "The folder cannot be read."
msgstr "No se puede leer la carpeta."

#: web/routes/picker.py
msgid "Write a name for the folder."
msgstr "Escribí un nombre para la carpeta."

#: web/routes/picker.py
msgid "A folder name cannot contain “/” nor start with a dot."
msgstr "El nombre de una carpeta no puede contener «/» ni empezar con un punto."

#: web/routes/picker.py
msgid "A folder with that name already exists."
msgstr "Ya existe una carpeta con ese nombre."

#: web/routes/picker.py
#, python-format
msgid "The folder could not be created: %(reason)s"
msgstr "No se pudo crear la carpeta: %(reason)s"

#: web/routes/vocabulary.py
msgid "Write a term."
msgstr "Escribí un término."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is already in the list."
msgstr "«%(term)s» ya está en la lista."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is not in the list."
msgstr "«%(term)s» no está en la lista."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is a topic the wiki covers: it cannot go to the blacklist."
msgstr "«%(term)s» es un tema que la wiki cubre: no puede ir a la lista negra."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is not in the roster: choose one of its names."
msgstr "«%(term)s» no está en el padrón: elegí uno de sus nombres."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is the name of another topic of the wiki."
msgstr "«%(term)s» es el nombre de otro tema de la wiki."

#: web/routes/vocabulary.py
#, python-format
msgid "The alias “%(alias)s” of “%(canonical)s” is the name of “%(other)s”."
msgstr "El alias «%(alias)s» de «%(canonical)s» es el nombre de «%(other)s»."

#: web/routes/vocabulary.py
#, python-format
msgid "There are aliases for “%(canonical)s”, which has no page nor dataset."
msgstr "Hay alias para «%(canonical)s», que no tiene página ni dataset."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(name)s”"
msgstr "«%(name)s»"

#: web/routes/vocabulary.py
#, python-format
msgid "The alias “%(alias)s” belongs to several names: %(names)s."
msgstr "El alias «%(alias)s» pertenece a varios nombres: %(names)s."

#: web/routes/vocabulary.py
#, python-format
msgid "“%(term)s” is in the blacklist, but the wiki now covers it."
msgstr "«%(term)s» está en la lista negra, pero ahora la wiki lo cubre."

#: web/routes/vocabulary.py
msgid "No dataset holds that name."
msgstr "Ningún dataset tiene ese nombre."

#: web/templates/_browse_panel.html

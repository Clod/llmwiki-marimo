# LLM Wiki — environment configuration
# Copy to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────

# Path to your wiki workspace (where sources/, wiki/, and .llmwiki/ are created).
# This is the default wiki — the web interface has a picker to switch at runtime.
WIKI_PATH=/path/to/your/wiki

# ── Optional: multi-wiki discovery ────────────────────────────────────────────
# Folder the picker scans for sibling wikis. Defaults to the parent of WIKI_PATH.
# WIKI_HOME=/path/to/your/wikis

# LLM for chat and (by default) wiki generation.
# Any OpenAI-compatible endpoint works — set these three. Example below is
# Ollama (local, free; nothing leaves your machine):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama                       # any non-empty string for Ollama
LLM_MODEL=llama3.2
#
# Cloud alternative (OpenRouter):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-haiku-5.5
#
# LM Studio (local, free):
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lm-studio
#   LLM_MODEL=local-model-name

# ── Optional: separate LLM for wiki generation ────────────────────────────────
# Use a stronger model for ingest while keeping a cheap/local model for chat.
# If blank, falls back to LLM_* above.
WIKI_LLM_BASE_URL=
WIKI_LLM_API_KEY=
WIKI_LLM_MODEL=

# ── Optional: vision model that describes the images of the sources ──────────
# Used only by the wikis that set `describe = true` in the [images] section of
# wiki_config.toml. Any OpenAI-compatible endpoint that accepts images works.
# A blank value falls back to WIKI_LLM_*, and that one to LLM_*.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ── Optional: OCR for scanned PDFs ────────────────────────────────────────────
# PDF extraction reads the text layer (opendataloader-pdf). A PDF with no text
# layer (a scan) needs OCR; the engine is chosen here. A DOCX never uses OCR.
#   none       (default) a scanned PDF fails with a message that names this setting.
#   tesseract  local: ocrmypdf + Tesseract, run as external programs. Install them:
#                macOS:          brew install ocrmypdf tesseract tesseract-lang
#                Debian/Ubuntu:  sudo apt-get install ocrmypdf tesseract-ocr tesseract-ocr-spa
#                Windows:        https://ocrmypdf.readthedocs.io/en/latest/installation.html#windows
#              The language follows the wiki language (spa for es, eng for en).
#              The text-layer copy is kept as .llmwiki/cache/local/<doc id>/ocr.pdf.
#   vision     a model with vision reads each page (one model call per page; the
#              text may vary between runs). Needs the three values below; each
#              one falls back to its LLM_* value when blank.
OCR_ENGINE=none
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# ── Optional: git auto-commit ─────────────────────────────────────────────────
# Each ingest commits the generated wiki/ to a git repo inside WIKI_PATH
# (labelled snapshots, version history of your knowledge base). Needs the `git`
# binary; if git is missing it's skipped automatically (with a warning) and
# ingestion still works. Set to a falsy value (0/false/no/off) to disable
# entirely — no git init, no commits — and manage the wiki's git yourself.
# WIKI_AUTOCOMMIT=1

# ── Debug ─────────────────────────────────────────────────────────────────────
# WIKI_DEBUG=1   # verbose logging in the marimo apps (the web interface does not read it)
